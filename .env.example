# ─────────────────────────────────────────────────────────────
# data-backtest-pipeline — configuration template
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Warehouse backend: duckdb | snowflake
WAREHOUSE_BACKEND=duckdb
DUCKDB_PATH=./data/warehouse.duckdb

# Snowflake (only if WAREHOUSE_BACKEND=snowflake)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=

# Market data source (no API key required for yfinance)
PRICE_SOURCE=yfinance
UNIVERSE_FILE=./config/universe.txt
BENCHMARK_TICKER=SPY
PRICE_HISTORY_START=2015-01-01

# Raw layer
RAW_DATA_DIR=./data/raw

# Macro (M3.5)
FRED_API_KEY=changeme
MACRO_SERIES_FILE=./config/macro_series.yml
MACRO_HISTORY_START=2015-01-01

# Fundamentals (M3.7)
# SEC requires a descriptive User-Agent with contact info.
# Format: "AppName ContactEmail" — SEC blocks anonymous requests.
SEC_USER_AGENT="data-backtest-pipeline you@example.com"
FUNDAMENTAL_TAGS_FILE=./config/fundamental_tags.yml
FUNDAMENTAL_HISTORY_START=2015-01-01

# MLflow
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=data-backtest-pipeline

# Prefect
PREFECT_API_URL=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# App
STREAMLIT_SERVER_PORT=8501
